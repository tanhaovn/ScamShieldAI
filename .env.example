USE_SQLITE=true
USE_DEEPFAKE_MODEL=false
# Bật Qwen2.5-VL 3B để model nhìn ảnh và nêu bằng chứng theo ngữ cảnh.
# Lần đầu chạy sẽ tải model nhiều GB; GPU CUDA được khuyến nghị.
USE_VLM_ANALYZER=false
VLM_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
VLM_DEVICE=auto
# Tùy chọn: đường dẫn model PhishVN .joblib tự huấn luyện.
# Nếu bỏ trống, backend ưu tiên models/phishvn_url_histgb.joblib rồi dùng model trong bundle PhishVN.
PHISHVN_MODEL_PATH=

# Đối chiếu URL với danh sách đe dọa Google Safe Browsing v5 (phi thương mại).
# Tạo API key trong Google Cloud Console và bật Safe Browsing API.
# URL cần kiểm tra sẽ được gửi tới Google; xem lưu ý quyền riêng tư trong README.
GOOGLE_SAFE_BROWSING_API_KEY=

# Google Identity Services (Web OAuth client ID).
# Backend va frontend phai dung cung mot Client ID.

# Nếu muốn dùng MySQL thật, đổi USE_SQLITE=false và điền thông tin dưới đây
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scam_detector
APP_ENV=development
# Production must use a long random value and must never keep the development default.
JWT_SECRET=replace-with-a-long-random-secret
